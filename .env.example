# InnoLab 环境变量模板
# 复制为 .env.local（本地开发）或在 Vercel Dashboard 设置（生产）

# ─── 必填 ───────────────────────────────────────────

# 站点根 URL（不含末尾斜杠）
# 本地：http://localhost:3001
# 生产：https://innolab.qiuyiwu.com  ← 计划的子域
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 小米 MiMo API（OpenAI 兼容协议）
# /api/analyze 必需，否则 /demo 实时模式会报"未配置 key"
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# 切换模型只需改这里：mimo-v2.5-pro（默认）或 mimo-v2.5
# 想换其他 OpenAI 兼容供应商（DeepSeek/通义/智谱），改 BASE_URL + KEY + MODEL 三件即可

# ─── 选填（调配额）─────────────────────────────────

# /api/analyze 每日配额。不设默认：全站 50 次，单 IP 5 次。
# INNOLAB_DAILY_QUOTA_GLOBAL=50
# INNOLAB_DAILY_QUOTA_PER_IP=5

# ─── 选填（v1.0 才会用上）─────────────────────────

# Resend Audiences（持久化候补邮件；v0.1 默认只 console.log）
# RESEND_API_KEY=re_xxx
# RESEND_AUDIENCE_ID=xxx

# Upstash Redis（生产级限流；目前用内存 map 兜底）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
