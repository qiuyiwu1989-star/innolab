# InnoLab 环境变量模板
# 复制为 .env.local（本地开发）或在 Vercel Dashboard 设置（生产）

# ─── 必填 ───────────────────────────────────────────

# 站点根 URL（不含末尾斜杠）
# 本地：http://localhost:3000
# 生产：https://innolab.qiuyiwu.com  ← 计划的子域
# 影响：sitemap.xml / robots.txt / OG image URL / canonical 等
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API Key — /api/analyze 必需，否则 /demo 实时模式会报"未配置 key"
# 拿 key：https://console.anthropic.com/settings/keys
# 本地：写进 .env.local（git 已忽略）；生产：在 Vercel Env Vars 配
ANTHROPIC_API_KEY=

# ─── 选填（调配额）─────────────────────────────────

# /api/analyze 每日配额。不设默认：全站 50 次，单 IP 5 次。
# 上 Vercel 之后建议根据实际流量和 Anthropic 余额调整。
# INNOLAB_DAILY_QUOTA_GLOBAL=50
# INNOLAB_DAILY_QUOTA_PER_IP=5

# ─── 选填（v1.0 才会用上）─────────────────────────

# Resend Audiences（持久化候补邮件；v0.1 默认只 console.log）
# RESEND_API_KEY=re_xxx
# RESEND_AUDIENCE_ID=xxx

# Upstash Redis（生产级限流；目前用内存 map 兜底）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
