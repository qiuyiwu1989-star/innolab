# InnoLab 环境变量模板
# 复制为 .env.local（本地开发）或在 Vercel Dashboard 设置（生产）

# ─── 必填 ───────────────────────────────────────────

# 站点根 URL（不含末尾斜杠）
# 本地：http://localhost:3001
# 生产（主域）：https://innolab.cc   （老域名 innolab.qiuyiwu.com 已 301 跳转至此）
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 小米 MiMo API（OpenAI 兼容协议）
# /api/analyze 必需，否则 /demo 实时模式会报"未配置 key"
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# 切换模型只需改这里：mimo-v2.5-pro（默认）或 mimo-v2.5
# 想换其他 OpenAI 兼容供应商（DeepSeek/通义/智谱），改 BASE_URL + KEY + MODEL 三件即可

# ─── 选填（调配额）─────────────────────────────────

# /api/analyze 每日配额。不设默认：全站 50 次，单 IP 5 次。
# INNOLAB_DAILY_QUOTA_GLOBAL=50
# INNOLAB_DAILY_QUOTA_PER_IP=5

# ─── 选填（v1.0 才会用上）─────────────────────────

# Resend Audiences（持久化候补邮件；v0.1 默认只 console.log）
# RESEND_API_KEY=re_xxx
# RESEND_AUDIENCE_ID=xxx

# Upstash Redis（生产级限流；目前用内存 map 兜底）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── 联网搜索（两条独立通路，默认都关 = 纯推演，不影响现有功能）──────────

# A) MiMo 原生联网搜索（推荐）：开了之后给推演挂 web_search 工具，由 MiMo 服务端联网。
#    ⚠ 前提：这个 MIMO_API_KEY(token) 必须已在 MiMo/中台控制台开通「联网搜索/webSearchEnabled」，
#    否则网关会对每个推演请求回 400。务必开通并验证后再置 on。
# MIMO_WEB_SEARCH=on

# B) Tavily 兜底（与 MiMo 解耦）：配 key 即在命中实时信号时先检索再注入。
#    MIMO_WEB_SEARCH=on 时此路自动让位给原生搜索。
# WEB_SEARCH_API_KEY=tvly-xxx
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_BASE=https://api.tavily.com

# ─── 数据库：飞轮数据持久仓（自托管 Supabase, sb.ai.zaowuyun.com）──────────
# 不配置 = 回落本地 JSONL（data/*.jsonl），行为与迁移前完全一致。
# 配上这两个 → 对话/留资/反馈/候选案例 自动走 Supabase（innolab_* 表）。
# service_role key 绕过 RLS、只能服务端用；只进 .env.local(chmod 600)，绝不进 git。
# 切换前：先在 Supabase 跑 db/schema.sql 建表，再 node scripts/migrate-jsonl-to-supabase.mjs 导旧数据。
# SUPABASE_URL=https://sb.ai.zaowuyun.com
# SUPABASE_SERVICE_ROLE_KEY=

# ─── 远程 MCP 端点 /mcp（把 InnoLab 推演能力做成可被 agent 调用的原语）──────────
# 不配置任一 key → /mcp 返回 503（绝不默认开放）。key 是连接凭证，绝不进 git。
# 见 docs/mcp-architecture.md。调用方带 Authorization: Bearer <key> 或 ?key=<key>。
# 单 key（标签取 INNOLAB_MCP_LABEL，默认「邱懿武」）：
# INNOLAB_MCP_KEY=
# INNOLAB_MCP_LABEL=邱懿武
# 多 key=标签（分号分隔，优先于单 key，用于区分不同调用方来源）：
# INNOLAB_MCP_KEYS="k1=邱懿武;k2=造物云"
