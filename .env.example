# InnoLab 环境变量模板
# 复制为 .env.local（本地开发）或在 Vercel Dashboard 设置（生产）

# ─── 必填 ───────────────────────────────────────────

# 站点根 URL（不含末尾斜杠）
# 本地：http://localhost:3000
# 生产：https://innolab.your-domain.com（替换为你的实际域名）
# 影响：sitemap.xml / robots.txt / OG image URL / canonical 等
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── 选填（v1.0 才会用上）─────────────────────────

# Anthropic API Key（v1.0 AI 战略咨询师才用，v0.1 不需要）
# ANTHROPIC_API_KEY=sk-ant-xxx

# Resend Audiences（用于持久化候补邮件，v0.1 默认只 console.log）
# RESEND_API_KEY=re_xxx
# RESEND_AUDIENCE_ID=xxx
